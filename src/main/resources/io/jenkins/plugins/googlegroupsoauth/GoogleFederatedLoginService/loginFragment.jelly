<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <j:if test="${it.enabled}">
    <st:adjunct includes="io.jenkins.plugins.googlegroupsoauth.GoogleFederatedLoginService.login-button"/>
    <j:set var="fromSafe" value="${empty(from) ? '' : h.urlEncode(from)}"/>
    <div class="google-groups-oauth-login">
      <a class="jenkins-button" href="${rootURL}/securityRealm/commenceLogin?from=${fromSafe}">
        <l:icon src="symbol-google plugin-google-groups-oauth"/>
        ${%Sign in with Google}
      </a>
    </div>
  </j:if>
</j:jelly>
